<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Story" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="fontFamily">@font/fredoka</item>
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="strokeColor">@color/md_theme_outline</item>
        <item name="android:statusBarColor">@color/md_theme_primary</item>
        <!-- Customize your light theme here. -->
    </style>

    <style name="Story.TextAppearance.Logo" parent="TextAppearance.Material3.ActionBar.Title">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.Story.ActionBar" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="titleTextAppearance">@style/Story.TextAppearance.Logo</item>
    </style>

    <style name="Theme.Story.FullScreenDialog.Animation.Slide" parent="">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <style name="Theme.Story.FullScreenDialog" parent="">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="Theme.Story.Post.Actions" parent="">
        <item name="android:textViewStyle">@style/Theme.Story.Post.Actions.Text</item>
    </style>

    <style name="Theme.Story.Post.Actions.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Story.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="errorIconDrawable">@null</item>
        <item name="errorEnabled">true</item>
    </style>

    <style name="Story.TextInputLayout.Primary" parent="Story.TextInputLayout">
    </style>

    <style name="Story.TextInputLayout.OnTertiary" parent="Story.TextInputLayout">
    </style>

    <style name="Story.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:drawablePadding">6dp</item>
        <item name="drawableTint">?attr/colorOnPrimary</item>
    </style>

    <style name="Story.TextInputEditText.Primary" parent="Story.TextInputEditText">
    </style>

    <style name="Story.TextInputEditText.OnTertiary" parent="Story.TextInputEditText">
    </style>

    <style name="Theme.Story.Button.Primary" parent="">
        <item name="android:textAppearanceButton">@style/Story.TextAppearance.Button.Primary</item>
        <item name="android:background">@drawable/button_background</item>
    </style>

    <style name="Story.Button.Primary" parent="">
        <item name="android:theme">@style/Theme.Story.Button.Primary</item>
        <item name="android:background">@drawable/button_background</item>
    </style>

    <style name="Story.Button.OnTertiary" parent="">
    </style>
    
    <style name="Story.TextAppearance.Body.White" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
    </style>
    
    <style name="Story.TextAppearance.Button.Primary" parent="Story.TextAppearance.Body.White">
    </style>
</resources>